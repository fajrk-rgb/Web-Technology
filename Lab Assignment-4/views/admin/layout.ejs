<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - <%= title %></title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
        }

        .sidebar {
            width: 240px;
            height: 100vh;
            position: fixed;
            background: #212529;
            padding-top: 20px;
        }

        .sidebar a {
            display: block;
            color: white;
            padding: 12px 20px;
            text-decoration: none;
        }

        .sidebar a:hover {
            background: #343a40;
        }

        .content {
            margin-left: 240px;
            padding: 20px;
        }

        .brand {
            color: white;
            font-size: 20px;
            font-weight: bold;
            padding: 10px 20px;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">

        <div class="brand">
            Admin Panel
        </div>

        <a href="/admin">Dashboard</a>
        <a href="/admin/products">Products</a>
        <a href="/admin/products/add">Add Product</a>
        <a href="/admin/orders">Orders</a>

        <hr style="color:white;">

        <a href="/">Back to Site</a>

    </div>

    <!-- MAIN CONTENT -->
    <div class="content">

        <%- body %>

    </div>

</body>

</html>