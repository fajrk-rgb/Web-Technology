<h2 class="mb-4">
    Edit Product
</h2>

<form
    action="/admin/products/edit/<%= product._id %>"
    method="POST"
    enctype="multipart/form-data"
>

    <!-- PRODUCT NAME -->

    <div class="mb-3">

        <label class="form-label">
            Product Name
        </label>

        <input
            type="text"
            name="name"
            class="form-control"
            value="<%= product.name %>"
            required
        >

    </div>



    <!-- PRICE -->

    <div class="mb-3">

        <label class="form-label">
            Price
        </label>

        <input
            type="number"
            step="0.01"
            name="price"
            class="form-control"
            value="<%= product.price %>"
            required
        >

    </div>



    <!-- CATEGORY -->

    <div class="mb-3">

        <label class="form-label">
            Category
        </label>

        <input
            type="text"
            name="category"
            class="form-control"
            value="<%= product.category %>"
            required
        >

    </div>



    <!-- RATING -->

    <div class="mb-3">

        <label class="form-label">
            Rating
        </label>

        <input
            type="number"
            step="0.1"
            name="rating"
            class="form-control"
            value="<%= product.rating %>"
            required
        >

    </div>



    <!-- STOCK -->

    <div class="mb-3">

        <label class="form-label">
            Stock
        </label>

        <input
            type="number"
            name="stock"
            class="form-control"
            value="<%= product.stock %>"
            required
        >

    </div>


    <div class="mb-3">

    <label class="form-label">
        Featured Section
    </label>

    <select
        name="featuredSections"
        class="form-select"
    >

        <option value="">
            None
        </option>

        <option
            value="new-release"
            <%= product.featuredSections &&
                product.featuredSections.includes("new-release")
                ? "selected"
                : ""
            %>
        >
            New Release
        </option>

        <option
            value="best-seller"
            <%= product.featuredSections &&
                product.featuredSections.includes("best-seller")
                ? "selected"
                : ""
            %>
        >
            Best Seller
        </option>

        <option
            value="featured"
            <%= product.featuredSections &&
                product.featuredSections.includes("featured")
                ? "selected"
                : ""
            %>
        >
            Featured
        </option>

        <option
            value="trending"
            <%= product.featuredSections &&
                product.featuredSections.includes("trending")
                ? "selected"
                : ""
            %>
        >
            Trending
        </option>

    </select>

</div>


    <!-- IMAGE -->

    <div class="mb-3">

        <label class="form-label">
            Product Image
        </label>

        <input
            type="file"
            name="image"
            class="form-control"
        >

    </div>



    <!-- CURRENT IMAGE -->

    <% if (product.image) { %>

        <div class="mb-3">

            <p>
                Current Image:
            </p>

            <img
                src="<%= product.image %>"
                alt="<%= product.name %>"
                width="120"
                height="120"
                style="object-fit: cover;"
                class="border rounded"
            >

        </div>

    <% } %>



    <!-- BUTTONS -->

    <button
        type="submit"
        class="btn btn-primary"
    >
        Update Product
    </button>

    <a
        href="/admin/products"
        class="btn btn-secondary"
    >
        Cancel
    </a>

</form>