
<div class="product-details-page">

    <div class="product-details-card">

        <img
            src="<%= product.image %>"
            alt="<%= product.name %>"
            onerror="this.src='/assets/default.jpg'"
        >

        <div class="details-content">

            <h1><%= product.name %></h1>

            <p>

                Category:
                <%= product.category %>

            </p>

            <p>

                Price:
                Rs. <%= product.price %>

            </p>

            <p>

                Rating:
                 <%= product.rating %>

            </p>

            <p>

                Stock:
                <%= product.stock %>

            </p>

            <button class="cart-btn">

                Add To Cart

            </button>

        </div>

    </div>

</div>

